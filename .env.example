# Public Supabase configuration.
# The anon key is designed for client use; database access must be protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional server-side connection values used by the legacy data helper.
# Never prefix server secrets with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Do not add SUPABASE_SERVICE_ROLE_KEY until service-role access is isolated
# in a server-only module and every caller has been audited.

# Optional staging-only integration test configuration.
# Use a dedicated non-production Supabase project and test accounts.
JINOX_TEST_SUPABASE_URL=
JINOX_TEST_SUPABASE_ANON_KEY=
JINOX_TEST_PROJECT_ID=
JINOX_TEST_DATASET_ID=
JINOX_TEST_OWNER_TOKEN=
JINOX_TEST_RESEARCHER_TOKEN=
JINOX_TEST_REVIEWER_TOKEN=
JINOX_TEST_VIEWER_TOKEN=
JINOX_TEST_UNRELATED_TOKEN=
JINOX_TEST_ASSIGNED_ITEM_ID=
JINOX_TEST_ASSIGNED_ASSET_ID=
JINOX_TEST_SUBMITTED_ANNOTATION_ID=
JINOX_TEST_DRAFT_ANNOTATION_ID=

# Existing staging-only pending clinical asset used by the asset approval regression test.
JINOX_TEST_PENDING_ASSET_ID=

# Dedicated staging-only asset review fixtures. Use synthetic records and separate
# admin, non-admin and uploader accounts; never use production patient data.
JINOX_TEST_ASSET_REVIEW_ADMIN_TOKEN=
JINOX_TEST_ASSET_REVIEW_NON_ADMIN_TOKEN=
JINOX_TEST_ASSET_REVIEW_OWNER_TOKEN=
JINOX_TEST_ASSET_REVIEW_ADMIN_SELF_OWNED_ID=
JINOX_TEST_ASSET_REVIEW_APPROVE_ID=
JINOX_TEST_ASSET_REVIEW_REJECT_ID=
JINOX_TEST_ASSET_REVIEW_QUARANTINE_ID=
JINOX_TEST_ASSET_REVIEW_CONCURRENT_ID=
