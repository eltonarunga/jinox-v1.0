{
  "name": "jinox-ai-prototype",
  "version": "1.0.0",
  "private": true,
  "description": "JinoX AI — full-stack prototype (Next.js + Supabase) for the multimodal oral & craniofacial health platform, Kenya pilot.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test:unit": "node --experimental-strip-types --test tests/unit/dataset-validation.test.mjs tests/unit/project-validation.test.mjs tests/unit/read-json.test.mjs tests/unit/safe-redirect.test.mjs tests/unit/public-supabase-config.test.mjs",
    "test:integration": "node --experimental-strip-types --test tests/integration/research-access.test.mjs",
    "test:annotation-workflow": "node --experimental-strip-types --test tests/integration/annotation-workflow.test.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.45.4",
    "next": "15.5.29",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.19",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.29",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3"
  },
  "overrides": {
    "postcss": "$postcss",
    "postcss-selector-parser": "6.1.6",
    "source-map-js": "1.2.2"
  }
}
